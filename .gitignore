# Python environment
venv/
.venv/
__pycache__/
*.pyc

# Data — never commit large binary datasets or generated tiers
data/daq/*
data/raw/*
data/dsp/*
data/hit/*
!data/daq/.gitkeep
!data/raw/.gitkeep
!data/dsp/.gitkeep
!data/hit/.gitkeep
# per-run output folders (e.g. data_260520_1340_liquid/)
data_*/
*.partial

# Analysis output, logs, scratch
results/
logs/
scratch*/
*.png

# Parsl run logs
runinfo/

# Test artifacts
.pytest_cache/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
